# Copy this file to .env at the repo root.
# `just` loads .env from the justfile directory (repo root) via `set dotenv-load := true`.
# Also copy to $TRTLLM_HOME/.env after running `just init` — docker compose reads it
# from that directory when `just compose-*` recipes cd there.
#
# TRTLLM_HOME — root directory for ALL TRT-LLM artifacts on this host.
#   models/     downloaded HuggingFace weights
#   engines/    built TRT-LLM engine files (output of trtllm-build)
#   cache/      HuggingFace model cache
#   logs/       optional container stdout logs
#   model_repo/ Triton model repository (config.pbtxt files)
#   compose.yaml  installed by `just compose-install`
#
# Default: /ai/trtllm-poc
TRTLLM_HOME=/ai/trtllm-poc

# HF_TOKEN — HuggingFace access token.
# Required for gated models (e.g. Llama family).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE
