# Copy this file to .env at the repo root.
# `just` loads .env from the justfile directory (repo root) via `set dotenv-load := true`.
# Also copy to $TRTLLM_HOME/.env after running `just init` — docker compose reads it
# from that directory when `just compose-*` recipes cd there.
#
# TRTLLM_HOME — root directory for ALL TRT-LLM artifacts on this host.
#   models/     downloaded HuggingFace weights
#   engines/    built TRT-LLM engine files (output of trtllm-build)
#   cache/      HuggingFace model cache
#   logs/       optional container stdout logs
#   model_repo/ Triton model repository (config.pbtxt files)
#   compose.yaml  installed by `just compose-install`
#
# Default: /ai/trtllm-poc
TRTLLM_HOME=/ai/trtllm-poc

# HF_TOKEN — HuggingFace access token.
# Required for gated models (e.g. Llama family).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── Rust client ──────────────────────────────────────────────────────────────
# TRTLLM_HOST / TRTLLM_PORT — target for `cargo run -- smoke-test`.
# Port 9000 = OpenAI-compatible frontend (/v1/chat/completions).
# Port 8000 = Triton native v2 (not used by the Rust client).
TRTLLM_HOST=localhost
TRTLLM_PORT=9000

# ── OpenAI frontend (optional overrides) ────────────────────────────────────
# These are read by scripts/start-triton.sh inside the container.
# OPENAI_TOKENIZER — HF model dir for chat-template tokenization.
#   Must be an absolute path inside the container (i.e. under /workspace/trtllm/).
# OPENAI_PORT — port the OpenAI frontend listens on (default: 9000).
# OPENAI_TOKENIZER=/workspace/trtllm/models/qwen-coder-7b
# OPENAI_PORT=9000

# ── Model-control mode (triton_wrapper.py) ───────────────────────────────────
# TRITON_MODEL_CONTROL_MODE: explicit (default) = no models loaded at startup;
#   Triton waits for explicit load via KServe API (just models-load <pipeline>).
#   Set to "none" to revert to old behaviour (all model_repo/ dirs loaded on start).
# DEFAULT_MODEL: pipeline to auto-load after Triton becomes ready.
#   Valid values: qwen | llama | vision | (empty string = nothing loaded)
#   Recommended for daily use: DEFAULT_MODEL=qwen (restores Sprint 001 behaviour)
# TRITON_MODEL_CONTROL_MODE=explicit
# DEFAULT_MODEL=qwen
